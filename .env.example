# LLM Provider
LLM_PROVIDER=gemini

# Gemini Configuration - Use stable 1.5 Flash
GOOGLE_API_KEY=your_api_key
GEMINI_MODEL=gemini-2.5-flash

# Ollama (keep as fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# GitHub
GITHUB_TOKEN=
GITHUB_REPO=your-username/data-engineering-agent

# Mock Data
USE_MOCK_DATA=true
MOCK_DATA_PATH=./mock_data
